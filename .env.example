# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID for alerts (your personal chat ID or group chat ID)
# Send /start to your bot, then check https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Comma-separated admin chat IDs for /admin commands
ADMIN_CHAT_IDS=

# Gold price source: "yfinance" or "goldapi"
# yfinance is free but can be slow; goldapi needs a free key
GOLD_PRICE_SOURCE=yfinance

# GoldAPI.io key (optional, only if using goldapi source)
GOLDAPI_KEY=

# India markup applied to every INR price path (customs duty + GST +
# premium). Recalibrate when India's budget changes duties.
INDIA_MARKUP=1.15

# Minimum minutes between alerts for the same topic cluster
ALERT_COOLDOWN_MINUTES=30

# Relevance threshold for instant alerts (1-10, higher = stricter)
# Items scoring below this are saved but not pushed immediately
ALERT_THRESHOLD=7

# Digest schedule (IST timezone)
MORNING_DIGEST_HOUR=8
EVENING_DIGEST_HOUR=20

# How often to check RSS feeds (minutes)
RSS_POLL_INTERVAL_MINUTES=15

# How often to check economic calendar (minutes)
CALENDAR_POLL_INTERVAL_MINUTES=30

# How often to refresh gold price (minutes)
PRICE_REFRESH_MINUTES=5

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
